# RentHub Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/renthub
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/renthub?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=renthub_super_secret_jwt_key_development_change_in_production_2026
JWT_EXPIRE=7d

# Allowed Frontend Origins for CORS (comma-separated)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

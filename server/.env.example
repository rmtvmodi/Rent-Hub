# RentHub Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/renthub
# Production MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/renthub?retryWrites=true&w=majority

# JWT Authentication Secrets
# In production, generate a strong random secret (at least 32 characters), e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-strong-random-64-plus-char-secret>
JWT_EXPIRE=7d

# Allowed Frontend Origins for CORS (comma-separated, no trailing slashes)
# Development:
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
# Production example:
# CLIENT_URL=https://your-renthub-frontend.com

# Optional: External Backend API URL served to frontend via /js/config.js (leave blank for same-origin /api)
PUBLIC_API_URL=
